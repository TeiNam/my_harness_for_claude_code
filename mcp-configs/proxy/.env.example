# mcp-configs/proxy/.env.example — proxy 컨테이너가 읽는 시크릿.
# config.json 의 ${VAR} 가 컨테이너 안에서 이 값으로 치환된다.
#
# 키 넣는 법 2가지 (하나만 택):
#   1) 셸 rc (권장) — ~/.zshrc 또는 ~/.bashrc 에 export 하면 이 파일을 안 만들어도 됨.
#        export GITHUB_PAT="ghp_xxx"
#        export BRAVE_API_KEY="BSA_xxx"
#      compose 가 셸 env 를 먼저 읽는다(빈 .env 보다 우선). rc 수정 후 `source ~/.zshrc`.
#   2) 이 파일 — `cp .env.example .env` 후 값 채우기. .env 는 커밋 안 됨(.gitignore).
#
# 셸 rc 에 export 했으면 .env 는 비워둬도 됨(아래 빈 값이 셸 값을 덮지 않음).

# GitHub MCP (remote) — Personal Access Token. github.com/settings/tokens
GITHUB_PAT=
# Brave Search MCP — api.search.brave.com/app/keys (free tier 2,000 queries/mo)
BRAVE_API_KEY=
# exa·context7·time 은 키 불필요 (exa remote HTTP, context7·time 은 무인증).
