# mcp-configs/proxy/.env.example — proxy 컨테이너가 읽는 시크릿.
# config.json 의 ${VAR} 가 컨테이너 안에서 이 값으로 치환된다.
#
# 키 넣는 법 2가지 (하나만 택):
#   1) 셸 rc (권장) — ~/.zshrc 또는 ~/.bashrc 에 export 하면 이 파일을 안 만들어도 됨.
#        export GITHUB_PAT="ghp_xxx"
#        export BRAVE_API_KEY="BSA_xxx"
#      compose 가 셸 env 를 먼저 읽는다(빈 .env 보다 우선). rc 수정 후 `source ~/.zshrc`.
#   2) 이 파일 — `cp .env.example .env` 후 값 채우기. .env 는 커밋 안 됨(.gitignore).
#
# 셸 rc 에 export 했으면 .env 는 비워둬도 됨(아래 빈 값이 셸 값을 덮지 않음).

# GitHub MCP (remote) — Personal Access Token. github.com/settings/tokens
GITHUB_PAT=
# Brave Search MCP — api.search.brave.com/app/keys (free tier 2,000 queries/mo)
BRAVE_API_KEY=
# Obsidian MCP — Local REST API 플러그인 API 키. 컨테이너는 host.docker.internal:27124 로 호스트 Obsidian 에 접근.
OBSIDIAN_API_KEY=
# AWS MCP(awslabs.*) — devops·finops·cloud·data-analysis 워크로드용.
# ⚠️ SSO(IAM Identity Center)로만 인증하세요. 장기 액세스 키(aws_access_key_id/secret) 금지.
#   1) `aws configure sso` 로 프로필 한 번 설정 (SSO start URL·계정·역할).
#   2) `aws sso login --profile <name>` 로 로그인 → ~/.aws 에 SSO 캐시 생성.
#   3) 아래 AWS_PROFILE 에 그 프로필 이름을. 컨테이너가 ~/.aws:/root/.aws:ro 로 읽습니다.
#   세션 만료 시 `aws sso login` 재실행 후 컨테이너 재기동.
AWS_PROFILE=
AWS_REGION=
# exa·context7·time·fetch·drawio·token-optimizer·aws-documentation·terraform 은 키 불필요
# (exa remote HTTP, terraform 은 내부 컨테이너, 나머지는 무인증). TFE 워크스페이스 관리 시 compose 에서 TFE_TOKEN 주석 해제.
