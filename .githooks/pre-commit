#!/bin/sh
# pre-commit: CHANGELOG.md 를 커밋 날짜별로 묶어 재생성하고, 지금 만들어지는
# 커밋에 함께 포함시킨다(git add). 커밋 후 워킹트리는 깨끗하게 유지된다.
# 네이티브 git 훅이라 GitKraken 등 모든 클라이언트에서 동일하게 동작.
#
# ponytail: 현재 커밋의 자기 자신 항목은 못 들어간다(커밋 해시가 아직 없음).
#           즉 "직전까지의 이력"을 담는다 — 마지막 한 줄은 다음 커밋 때 채워짐.

# rebase/merge/cherry-pick 중에는 churn 방지를 위해 건너뛴다.
git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD; do
  [ -e "$git_dir/$state" ] && exit 0
done

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
out="$root/CHANGELOG.md"

# 아직 커밋이 하나도 없으면(최초 커밋) git log 가 실패하므로 조용히 종료.
git rev-parse HEAD >/dev/null 2>&1 || exit 0

{
  printf '# Changelog\n\nAll notable changes, grouped by commit date.\n'
  # %cd=커밋날짜(short), %s=제목, %h=축약 해시. 0x1f(US) 로 필드 구분.
  git log --date=short --pretty=format:'%cd%x1f%s%x1f%h' | awk -F'\037' '
    $1 != prev { printf "\n## %s\n\n", $1; prev = $1 }
    { printf "- %s (%s)\n", $2, $3 }
  '
  printf '\n'
} > "$out" || exit 0

git add "$out" 2>/dev/null
exit 0
